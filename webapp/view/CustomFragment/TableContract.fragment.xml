<core:FragmentDefinition 
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:m="sap.m">

	<m:Table 
        headerText="{i18n>custom.meli.S3_ListItem.Items}({DatHeaderContract>/visibleRowCount})"
        busy="{DatHeaderContract>/TableItemBusy}"
		id="TB_ListItemContract" items="{ path: 'LineItemModel>/'}" ariaLabelledBy="title"
        visible="false">
		<m:columns>
			<m:Column
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItemContract.LineItem}" />
			</m:Column>
			<m:Column
				minScreenWidth="Tablet"
				demandPopin="true">
				<m:Text text="{i18n>custom.meli.S3_ListItemContract.Description}" />
			</m:Column>
			<m:Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItemContract.ProductGroup}" />
			</m:Column>
			<m:Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Center">
				<m:Text text="{i18n>custom.meli.S3_ListItemContract.Quantity}" />
			</m:Column>
			<m:Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItemContract.Unit}" />
			</m:Column>
			<m:Column
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItemContract.Amount}" />
			</m:Column>
			<m:Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItemContract.Status}" />
			</m:Column>
		</m:columns>
		<m:items>
			<m:ColumnListItem vAlign="Middle">
				<m:cells>
					<m:Text
						text="{LineItemModel>PurchaseContractItem}" />
					<m:Text
						text="{LineItemModel>PurchaseContractItemText}" />
					<m:Text
						text="{LineItemModel>MaterialGroup}" />
					<m:ObjectNumber
						number="{path: 'LineItemModel>TargetQuantity',
						type: 'sap.ui.model.type.Float',
						formatOptions: { 	maxFractionDigits: 2
						} }"
						unit=""
						emphasized="false"
						textDirection="RTL" />
					<m:Text
						text="{LineItemModel>OrderPriceUnit}" />
					<m:ObjectNumber
							number="{
								parts:[{path:'LineItemModel>ContractNetPriceAmount'},{path:'LineItemModel>DocumentCurrency'}],
								type: 'sap.ui.model.type.Currency',
								formatOptions: {showMeasure: false}
							}"
							unit="{LineItemModel>DocumentCurrency}" />
					<m:Text text="{path: 'LineItemModel>PurchasingContractDeletionCode', formatter:'.getTextStatusContract'}"/>
				</m:cells>
			</m:ColumnListItem>
		</m:items>
    </m:Table>
</core:FragmentDefinition>