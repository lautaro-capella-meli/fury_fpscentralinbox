<core:FragmentDefinition 
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:m="sap.m">
	<m:Table 
        headerText="{i18n>custom.meli.S3_ListItem.Items}({DatHeaderConcur>/visibleRowCount})"
        busy="{DatHeaderConcur>/TableItemBusy}"
		id="TB_ListItemConcur" items="{ path: 'LineItemModel>/'}" ariaLabelledBy="title"
        visible="false">
		<m:columns>
			<m:Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItemConcur.expenseTypeName}" />
			</m:Column>
			<m:Column width="9rem"
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItemConcur.transactionDate}" />
			</m:Column>
			<m:Column width="3rem"
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Begin">
				<m:Text text="" />
			</m:Column>
			<m:Column width="4rem"
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Begin">
				<m:Text text="" />
			</m:Column>
			<m:Column
				width="12em">
				<m:Text text="{i18n>custom.meli.S3_ListItemConcur.Amount}" />
			</m:Column>
			<m:Column
				width="12em"
				minScreenWidth="Tablet"
				demandPopin="true">
				<m:Text text="{i18n>custom.meli.S3_ListItemConcur.approvedAmount}" />
			</m:Column>
			<m:Column
				width="15em"
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItemConcur.Employee}" />
			</m:Column>
			<m:Column
				width="15em"
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItemConcur.CityOfPurchase}" />
			</m:Column>
			<m:Column width="10rem"
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItemConcurAttachment.Link}" />
			</m:Column>
		</m:columns>
		<m:items>
			<m:ColumnListItem vAlign="Middle">
				<m:cells>
					<m:Text
						text="{LineItemModel>expenseTypeName}" />
                    <m:Text text="{
                        path: 'LineItemModel>transactionDate',
						type: 'sap.ui.model.type.Date',
						formatOptions: {
							style: 'short'
						}
					}" />
					<m:ObjectStatus
							visible="{= ${LineItemModel>ExceptionSet}.results.length > 0  ? true : false }"
							class="sapUiSmallMarginBottom"
							text="{= ${LineItemModel>ExceptionSet}.results.length}"
							press="onPressExceptions"
							active="true"
							state="Warning"
							icon="sap-icon://alert" 
					/>	
					<m:Button 
						visible="{= ${LineItemModel>CommentSet}.results.length > 0  ? true : false }"
						text="{= ${LineItemModel>CommentSet}.results.length}" press="onPressComment" icon="sap-icon://comment" />
					<m:ObjectNumber
							number="{
								parts:[{path:'LineItemModel>postedAmount'},{path:'LineItemModel>postedAmountCurrency'}],
								type: 'sap.ui.model.type.Currency',
								formatOptions: {showMeasure: false}
							}"
							unit="{LineItemModel>postedAmountCurrency}" />
					<m:ObjectNumber
							number="{
								parts:[{path:'LineItemModel>approvedAmount'},{path:'LineItemModel>approvedAmountCurrency'}],
								type: 'sap.ui.model.type.Currency',
								formatOptions: {showMeasure: false}
							}"
							unit="{LineItemModel>approvedAmountCurrency}" />
					<m:Text
						text="{LineItemModel>vendorDescription}" />
					<m:Text
						text="{LineItemModel>locationCityName}" />
					<m:Link
							visible="{= ${LineItemModel>hasAttachment} ? true : false }"
							text="{i18n>custom.meli.S3_Concur.Attachment}"
							target="_blank"
							href="{LineItemModel>attachmentUrl}" />
				</m:cells>
			</m:ColumnListItem>
		</m:items>
    </m:Table>
</core:FragmentDefinition>