<core:FragmentDefinition 
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:m="sap.m">
	<m:Table 
        headerText="Items({DatHeaderAriba>/visibleRowCount})"
        busy="{DatHeaderAriba>/TableItemBusy}"
		id="TB_ListItem" items="{ path: 'LineItemModel>/'}" ariaLabelledBy="title"
        visible="false">
		<m:columns>
			<m:Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItem.LineItem}" />
			</m:Column>
<!-- 			<m:Column
				width="12em">
				<m:Text text="{i18n>custom.meli.S3_ListItem.CatalogType}" />
			</m:Column> -->
			<m:Column
				width="12em">
				<m:Text text="{i18n>custom.meli.S3_ListItem.Text}" />
			</m:Column>
			<m:Column
				minScreenWidth="Tablet"
				demandPopin="true">
				<m:Text text="{i18n>custom.meli.S3_ListItem.Commodity}" />
			</m:Column>
			<m:Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItem.Supplier}" />
			</m:Column>
			<m:Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Center">
				<m:Text text="{i18n>custom.meli.S3_ListItem.DeliveryDate}" />
			</m:Column>
			<m:Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItem.Quantity}" />
			</m:Column>

			<m:Column
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItem.Amount}" />
			</m:Column>
			<m:Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItem.Recipient}" />
			</m:Column>
			<m:Column
				minScreenWidth="Desktop"
				demandPopin="true"
				hAlign="Begin">
				<m:Text text="{i18n>custom.meli.S3_ListItem.PurchasingGroup}" />
			</m:Column>
		</m:columns>
		<m:items>
			<m:ColumnListItem vAlign="Middle">
				<m:cells>
					<m:Text
						text="{LineItemModel>numberInCollection}" />
<!-- 					<m:Text
						text="{LineItemModel>CatalogType}" /> -->
					<m:Text
						text="{LineItemModel>description}" />
					<m:Text
						text="{LineItemModel>commonCommodityCode}" />
					<m:Text
						text="{LineItemModel>supplierName} - {LineItemModel>supplier}" />

                    <m:Text text="{
                        path: 'LineItemModel>needBy',
						type: 'sap.ui.model.type.Date',
						formatOptions: {
							style: 'short'
						}
					}" />
					<m:ObjectNumber
						number="{path: 'LineItemModel>quantity',
						type: 'sap.ui.model.type.Float',
						formatOptions: { 	maxFractionDigits: 2
						} }"
						unit=""
						emphasized="false"
						textDirection="RTL" />
					<m:ObjectNumber
							number="{
								parts:[{path:'LineItemModel>amount'},{path:'LineItemModel>currency'}],
								type: 'sap.ui.model.type.Currency',
								formatOptions: {showMeasure: false}
							}"
							unit="{LineItemModel>currency}" />
					<m:Text
						text="{LineItemModel>purchaseOrg} - {LineItemModel>purchaseOrgName}" />
					<m:Text
						text="{LineItemModel>purchaseGroup} - {LineItemModel>purchaseGroupName}" />
				</m:cells>
			</m:ColumnListItem>
		</m:items>
    </m:Table>
</core:FragmentDefinition>